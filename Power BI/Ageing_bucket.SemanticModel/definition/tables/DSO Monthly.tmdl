table 'DSO Monthly'
	lineageTag: 8a71cb6a-3569-412c-b47d-5b762832549e

	measure 'Latest Countback DSO' =
			
			VAR LastMonth = MAX ( 'DSO Monthly'[month_start] )
			RETURN
			    CALCULATE (
			        SUM ( 'DSO Monthly'[countback_dso] ),
			        'DSO Monthly'[month_start] = LastMonth
			    )
		formatString: 0.0
		lineageTag: f022cae8-0d5f-49f2-994f-d68ee7ce04b8

	measure 'Daily Credit Sales' =
			
			VAR LastMonth =
			    CALCULATE ( MAX ( 'DSO Monthly'[month_start] ), REMOVEFILTERS ( 'Date' ) )
			RETURN
			    DIVIDE (
			        CALCULATE (
			            SUM ( 'DSO Monthly'[credit_sales] ),
			            REMOVEFILTERS ( 'Date' ),
			            'DSO Monthly'[month_start] > EDATE ( LastMonth, -12 )
			        ),
			        365
			    )
		lineageTag: 283e6e73-1f2d-4447-b390-6ff3ab0b6b5a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cash Released' =
			
			[DSO Reduction Value] * [Daily Credit Sales]
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: d8e044a0-e51b-47fb-b033-5bb60570906e

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

